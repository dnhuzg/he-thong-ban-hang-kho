# Chép file này thành app.properties rồi điền giá trị của máy bạn. app.properties không được commit.

db.url=jdbc:mysql://localhost:3306/oms?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
db.user=root
db.password=

# Mật khẩu tạm cho tài khoản "admin" được tạo lần đầu khi database chưa có người dùng.
admin.initialPassword=

app.baseUrl=http://localhost:8080/oms

# Gửi email qua Gmail: bật xác minh 2 bước, tạo App Password tại https://myaccount.google.com/apppasswords
# rồi điền mail.username (địa chỉ Gmail) + mail.password (16 ký tự App Password, bỏ dấu cách).
# Để trống mail.smtp.host thì email chỉ được ghi ra log Tomcat.
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.username=
mail.password=
mail.from=
mail.fromName=OMS Bán hàng & Kho

# Thư mục lưu ảnh tải lên (ảnh đại diện, ảnh sản phẩm), nằm ngoài Tomcat để không mất khi deploy lại.
# Để trống thì dùng thư mục oms-uploads trong thư mục người dùng.
upload.dir=
