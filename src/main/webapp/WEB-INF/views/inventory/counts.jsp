<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Kiểm kê kho"/><%@ include file="/WEB-INF/views/layout/app-top.jspf" %>
<section id="count-screen" data-can-write="<c:out value='${canWrite}'/>" data-csrf="<c:out value='${csrfToken}'/>" data-create-url="<c:out value='${ctx}/inventory/counts/create'/>" data-save-url="<c:out value='${ctx}/inventory/counts/save'/>" data-post-url="<c:out value='${ctx}/inventory/counts/post'/>" data-page-url="<c:out value='${ctx}/inventory/counts'/>">
 <div class="page-header"><div><p class="breadcrumb">Kho &amp; tồn kho / Kiểm kê</p><h1>Kiểm kê kho</h1><p class="page-header__desc">Chụp số tồn hệ thống, nhập số thực tế và chốt điều chỉnh có nhật ký.</p></div></div>
 <div class="grid grid--2">
  <section class="card"><div class="card__header"><h2>Tạo phiếu kiểm kê</h2></div><form id="count-create" class="stack" style="padding:1rem"><label class="form-field"><span class="form-label">Kho</span><select class="select" id="count-warehouse" required><option value="">— Chọn kho —</option></select></label><label class="form-field"><span class="form-label">Ghi chú</span><textarea class="textarea" id="count-note" maxlength="500"></textarea></label><button class="btn btn--primary" type="submit">Tạo phiếu từ tồn hiện tại</button></form></section>
  <section class="card"><div class="card__header"><h2>Phiếu gần đây</h2></div><div id="count-list" style="padding:1rem"></div></section>
 </div>
 <section class="card" id="count-detail" hidden style="margin-top:1rem"><div class="card__header"><div><h2 id="count-title"></h2><p id="count-meta" class="text-muted"></p></div><span class="badge" id="count-status"></span></div><div class="table-wrap"><table class="table"><thead><tr><th>SKU</th><th>Sản phẩm</th><th>Tồn lúc tạo</th><th>Tồn thực tế</th><th>Chênh lệch</th></tr></thead><tbody id="count-lines"></tbody></table></div><p class="alert alert--danger" id="count-error" hidden></p><div style="display:flex;gap:.75rem;justify-content:flex-end;padding:1rem"><button class="btn btn--secondary" id="count-save" type="button">Lưu số kiểm kê</button><button class="btn btn--primary" id="count-post" type="button">Chốt điều chỉnh tồn</button></div></section>
</section><script type="application/json" id="count-data"><c:out value="${countData}" escapeXml="false"/></script><script src="${ctx}/assets/js/inventory-counts.js?v=${assetVersion}" defer></script>
<%@ include file="/WEB-INF/views/layout/app-bottom.jspf" %>
