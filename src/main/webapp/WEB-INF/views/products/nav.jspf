<%-- Thanh tab khu vực "Sản phẩm & bảng giá"; trang đặt biến catalogTab trước khi include, servlet đặt canViewPriceLists --%>
        <nav class="tabs" aria-label="Danh mục sản phẩm">
          <a class="tabs__item ${catalogTab == 'products' ? 'is-active' : ''}" href="${ctx}/products" ${catalogTab == 'products' ? 'aria-current="page"' : ''}>Sản phẩm</a>
          <a class="tabs__item ${catalogTab == 'categories' ? 'is-active' : ''}" href="${ctx}/products/categories" ${catalogTab == 'categories' ? 'aria-current="page"' : ''}>Nhóm hàng</a>
          <c:if test="${canViewPriceLists}">
            <a class="tabs__item ${catalogTab == 'prices' ? 'is-active' : ''}" href="${ctx}/products/price-lists" ${catalogTab == 'prices' ? 'aria-current="page"' : ''}>Bảng giá</a>
          </c:if>
          <c:if test="${canManageDiscounts}">
            <a class="tabs__item ${catalogTab == 'discounts' ? 'is-active' : ''}" href="${ctx}/products/discounts" ${catalogTab == 'discounts' ? 'aria-current="page"' : ''}>Chiết khấu</a>
          </c:if>
        </nav>
